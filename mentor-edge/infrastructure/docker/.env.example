# ============================================================
# Mentor Edge — configuración por Jetson
# Copia este archivo a .env y rellena los valores reales
# ============================================================

# Base de datos (no cambiar salvo que uses otro nombre)
POSTGRES_DB=mentor_edge
POSTGRES_USER=mentor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Calibracion HSV persistente del detector
# Cantidad configurable; validar experimentalmente para cada instalacion.
CALIBRATION_SAMPLES=30
CALIBRATION_MIN_QUALITY=0.90
CALIBRATION_EXPIRY_DAYS=90

# --- PERSONALIZAR POR JETSON ---
# ID único del dispositivo (ej: jetson-orin-textil, jetson-orin-planta02)
DEVICE_ID=jetson-orin-XXXX

# Nombre de la línea para OEE (ej: MENTOR_PLANTA01_L1)
LINE_CODE=MENTOR_PLANTAXX_LX

# URL RTSP de la cámara asignada a este Jetson
CAMERA_URL=rtsp://usuario:contrasena@192.168.X.X:554/stream

# Backend de captura: opencv (siempre) | gstreamer (requiere NVDEC)
FRAME_BACKEND=opencv

OEE_INTERVAL=300

# --- SCOPE DE ORGANIZACIÓN ---
# IDs del cloud: obtenlos en Settings > Dispositivos del frontend cloud.
# Sin estos valores el enviador envía datos sin empresa/planta/línea asignados
# y el dashboard cloud NO los muestra.
EMPRESA_ID=0
LINEA_ID=0

# Token de autenticación para el edge-gateway (opcional, deja vacío si no hay auth)
EDGE_AUTH_TOKEN=

# --- CLOUD ---
# CLOUD_URL: URL base del cloud-gateway (ej: https://api.tudominio.com)
# CLOUD_API_KEY: API key POR DISPOSITIVO, generada en gateway.device_registry.
#                NO usar la EDGE_API_KEY global — usar la clave individual del Jetson.
CLOUD_URL=https://api.mentoredge.io
CLOUD_API_KEY=CHANGE_ME_API_KEY_PER_DEVICE

TZ=America/Lima
