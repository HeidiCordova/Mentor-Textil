# .env.rpi — Variables de entorno para el stack de energia en Raspberry Pi
# Copiar como .env y ajustar antes de ejecutar
# Uso: cp .env.rpi .env

TZ=America/Lima

# Identificador único del dispositivo (registrar en cloud antes de desplegar)
DEVICE_ID=rpienergy01

# Puerto serie RS-485 — nombre estable creado por udev
# Si no hay udev activo: usar /dev/ttyUSB0 o /dev/ttyAMA0
MODBUS_SERIAL_DEV=/dev/mc60-mbus

# Medidor 1 (obligatorio)
METER_ID_1=1
METER_UNIT_ID_1=1

# Medidor 2 (dejar vacío si no hay segundo medidor)
METER_ID_2=
METER_UNIT_ID_2=2

# Medidor 3 (dejar vacío si no hay tercer medidor)
METER_ID_3=
METER_UNIT_ID_3=3

# Medidor 4 (dejar vacío si no hay cuarto medidor)
METER_ID_4=
METER_UNIT_ID_4=4

# Medidor 5 (dejar vacío si no hay quinto medidor)
METER_ID_5=
METER_UNIT_ID_5=5

# Intervalo de lectura Modbus en milisegundos (default: 5 minutos)
METER_POLL_INTERVAL_MS=300000
