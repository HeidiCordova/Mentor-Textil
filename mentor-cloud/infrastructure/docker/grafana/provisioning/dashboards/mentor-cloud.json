{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["mentor"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Lima",
  "title": "Mentor Cloud",
  "uid": "mentor-cloud-v1",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Servidor",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "uso %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Memoria",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "uso %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "gauge",
      "id": 4,
      "title": "Disco /",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "(1 - node_filesystem_free_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) * 100",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 6, "y": 9, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "RAM Disponible",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 10, "y": 9, "w": 4, "h": 3 },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 524288000 },
              { "color": "green", "value": 1073741824 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Red",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 14, "y": 9, "w": 10, "h": 6 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br.*\"}[5m])",
          "legendFormat": "rx {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br.*\"}[5m])",
          "legendFormat": "tx {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "row",
      "id": 10,
      "title": "Base de Datos",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Conexiones PostgreSQL",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=~\"mentor.*\"}",
          "legendFormat": "{{datname}} {{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "bargauge",
      "id": 12,
      "title": "OEE Snapshots por Schema",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "pg_oee_snapshots_row_estimate",
          "legendFormat": "{{schemaname}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      }
    },
    {
      "type": "bargauge",
      "id": 13,
      "title": "Tamaño por Schema",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "pg_schema_size_bytes_bytes",
          "legendFormat": "{{schemaname}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color"
      }
    },
    {
      "type": "row",
      "id": 20,
      "title": "Ingest",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "OEE Registros / seg por Dispositivo",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(mentor_ingest_oee_records_total[5m])",
          "legendFormat": "device {{device_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Latencia Batch OEE p50 / p99",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(mentor_ingest_oee_batch_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 device {{device_id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(mentor_ingest_oee_batch_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 device {{device_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Stops / seg por Dispositivo",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(mentor_ingest_stops_total[5m])",
          "legendFormat": "device {{device_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Errores Ingest por Endpoint",
      "datasource": { "type": "prometheus", "uid": "mentor-prometheus" },
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(mentor_ingest_errors_total[5m])",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ]
}
