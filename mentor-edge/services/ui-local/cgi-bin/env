#!/bin/sh
ENV_PATH="/env-data/.env"

read -r method path _
len=0
while read -r header; do
  header=$(printf '%s' "$header" | tr -d '\r')
  [ -z "$header" ] && break
  case "$header" in Content-Length:*|content-length:*) len="${header#*: }" ;; esac
done

case "$method" in
  POST)
    head -c "$len" > "$ENV_PATH"
    printf "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n{\"status\":\"saved\"}\n"
    ;;
  GET)
    body=$(cat "$ENV_PATH" 2>/dev/null || true)
    blen=$(printf '%s' "$body" | wc -c)
    printf "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s" "$blen" "$body"
    ;;
  *)
    printf "HTTP/1.1 405 Method Not Allowed\r\nConnection: close\r\n\r\n"
    ;;
esac
