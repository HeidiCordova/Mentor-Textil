{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentoredge.io/schemas/event/v1",
  "title": "Mentor Edge Event v1",
  "description": "Schema congelado del evento generado por vision-event-detector. NO modificar sin incrementar version.",
  "type": "object",
  "required": ["event_id", "device_id", "event_type", "timestamp", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 unico generado por el detector"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Identificador del dispositivo Jetson"
    },
    "event_type": {
      "type": "string",
      "enum": ["CORTE"],
      "description": "Tipo de evento detectado"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC con timezone generado en el detector"
    },
    "payload": {
      "type": "object",
      "required": ["confidence", "roi_id", "signals"],
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fusion score que disparo el evento"
        },
        "roi_id": {
          "type": "string",
          "description": "Identificador del ROI activo"
        },
        "signals": {
          "type": "object",
          "required": ["edge", "color", "flow", "yolo"],
          "additionalProperties": false,
          "properties": {
            "edge": { "type": "number", "minimum": 0, "maximum": 1 },
            "color": { "type": "number", "minimum": 0, "maximum": 1 },
            "flow": { "type": "number", "minimum": 0, "maximum": 1 },
            "yolo": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
