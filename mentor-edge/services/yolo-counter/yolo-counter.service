[Unit]
Description=Mentor Edge — yolo-counter (YOLO26s bottle/box counting)
After=network.target mentor-edge-resiliencia.service mentor-edge-config.service
Wants=network.target

[Service]
Type=simple
User=orin
Group=orin
WorkingDirectory=/home/orin/Mentoredge/mentor-edge/services/yolo-counter
Environment="PATH=/opt/yolo-counter/venv/bin:/usr/local/cuda-12.6/bin:/usr/bin:/bin"
Environment="LD_LIBRARY_PATH=/usr/local/cuda-12.6/lib64:/usr/lib/aarch64-linux-gnu"
Environment="MODELS_DIR=/opt/yolo-counter/models"
Environment="CONFIG_SERVICE_URL=http://127.0.0.1:8004"
Environment="RESILIENCIA_URL=http://127.0.0.1:8002"
Environment="PORT=8006"
EnvironmentFile=-/home/orin/Mentoredge/mentor-edge/infrastructure/docker/.env
ExecStart=/opt/yolo-counter/venv/bin/python -m app.main
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yolo-counter
# --- Límites de recursos ---
# TRT inference + 1 thread RTSP ≈ 150% CPU real; limitar a 180% de un core
CPUQuota=180%
# RAM: TRT engine 300MB + PyTorch CUDA 200MB + supervision 50MB + buffer frames
# El kernel killará el proceso si supera este límite (evita OOM general)
MemoryMax=1800M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
